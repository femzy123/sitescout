# Neon PostgreSQL
DATABASE_URL=
# Optional direct connection for Drizzle migrations. DATABASE_URL is the fallback.
DATABASE_URL_UNPOOLED=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Google Places API (New)
GOOGLE_PLACES_API_KEY=

# AI provider
GEMINI_API_KEY=
AI_MODEL=gemini-3.7-flash

# Synchronous website audit
AUDIT_DEBUG=false
AUDIT_TIMEOUT_MS=180000
AUDIT_PAGE_TIMEOUT_MS=30000
AUDIT_LIGHTHOUSE_TIMEOUT_MS=60000
AUDIT_AI_TIMEOUT_MS=45000

# Production Chromium for Vercel. Keep this version aligned with
# @sparticuz/chromium-min in package.json. Current x64 pack:
# https://github.com/Sparticuz/chromium/releases/download/v149.0.0/chromium-v149.0.0-pack.x64.tar
CHROMIUM_PACK_URL=

# Optional local override. chrome-launcher auto-detects normal Chrome installs.
# Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_EXECUTABLE_PATH=
